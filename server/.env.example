# ── Railway sets these automatically ──────────────────────────────────────────
PORT=2567
NODE_ENV=production

# ── Supabase ───────────────────────────────────────────────────────────────────
# Project dashboard → Settings → Database → Connection string
#
# Option A — Direct connection (port 5432, session mode, up to 10 pool conns)
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
# Option B — Supavisor pooler (port 6543, transaction mode, recommended for stateless)
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# ── Game server ────────────────────────────────────────────────────────────────
TICK_RATE=20
MAX_PLAYERS_PER_SECTOR=64
SECTOR_SIZE=20000

# ── CORS ───────────────────────────────────────────────────────────────────────
# Your Vercel deployment URL (no trailing slash). Comma-separate for preview URLs.
# CLIENT_URL=https://neonprotocol.vercel.app
CLIENT_URL=https://neonprotocol.vercel.app
